HOST=127.0.0.1
PORT=11436
REQUEST_TIMEOUT_MS=120000

# Local OpenAI-compatible endpoint
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen3:14b
LOCAL_API_KEY=

# Default cloud provider: OpenAI API
# You can point CLOUD_BASE_URL at another OpenAI-compatible provider.
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
# OPENAI_API_KEY is also accepted as a fallback.

# Economic default routing models
LUNA_MODEL=gpt-5.6-luna
SOL_MODEL=gpt-5.6-sol

# Backward-compatible optional aliases
CHEAP_MODEL=
POWERFUL_MODEL=

# Optional OpenRouter compatibility/metadata
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Workstation Router

ROUTER_FALLBACK_ORDER=local,luna,sol
ROUTER_MEDIUM_CHARS=2500
ROUTER_COMPLEX_CHARS=7000
